# ─── Application ──────────────────────────────────────────────────────────────
SECRET_KEY=super-secret-smart-vision-key-CHANGE-ME-IN-PRODUCTION
DATABASE_NAME=smartvision

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Replace <username>, <password>, and <cluster> with your Atlas credentials
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartvision?retryWrites=true&w=majority

# ─── Email (for verification emails in production) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
